# StoneSight AI — copy to `.env` (project root) and fill in. Never commit `.env`.
# AI providers are strictly Anthropic Claude and NVIDIA. See docs/architecture.md.

# ---------------------------------------------------------------------------
# Browser (exposed to the client via Vite — no secrets here)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_API_URL="http://localhost:5000"   # URL of the StoneSight backend

# ---------------------------------------------------------------------------
# Backend (server only)
# ---------------------------------------------------------------------------
PORT=5000
CLIENT_URL="http://localhost:3000"      # comma-separated CORS origins (empty = allow all)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# MCP_TEST_MODE="true"                  # dev/testing only: bypasses login + API auth

# --- Claude Code analyst: scene analysis by a Claude Code session (no key) ---
# A Claude Code session next to the server answers each analysis job from
# claude-code/inbox/ (docs/claude-code-analyst.md). Not for unattended traffic.
# CLAUDE_CODE_ANALYST=on
# CLAUDE_CODE_ANALYST_DIR=claude-code
# CLAUDE_CODE_ANALYST_TIMEOUT_S=1800

# --- Anthropic Claude: scene analysis & prompt planning (recommended) --------
# With only this key the app is fully functional: Claude maps the stone
# surfaces and room geometry, the browser renders the stone, the 3D room and
# the walkthrough video.
ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-opus-5"            # override only if you need a different model
CLAUDE_ANALYSIS_EFFORT="high"           # low | medium | high | xhigh | max
CLAUDE_GROUNDING=1                      # set-of-mark pass: Claude picks numbered photo regions, outlines follow real edges (0 = off)
CLAUDE_REFINE_PASSES=0                  # optional self-check passes on an outline overlay (superseded by grounding)
# CLAUDE_BASE_URL=""                    # only for Anthropic-compatible gateways (e.g. https://api.oneprovider.dev); unset = api.anthropic.com

# --- NVIDIA ------------------------------------------------------------------
# API key from build.nvidia.com. Enables the hosted FLUX.1 Kontext endpoint
# (if your key accepts custom images) and the NVIDIA VLM fallback analyser.
NVIDIA_API_KEY="nvapi-..."
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_VLM_MODEL="meta/llama-3.2-90b-vision-instruct,meta/llama-3.2-11b-vision-instruct"  # tried in order

# Self-hosted / tunnelled FLUX.1 Kontext NIM (photoreal AI stone replacement).
# See docs/image-pipeline-setup.md.
FLUX_INFERENCE_URL=""                   # e.g. http://gpu-box:8001/v1/infer
# NVIDIA_IMAGE_EDIT_URL=""              # override the hosted Kontext endpoint
# NVIDIA_HOSTED_IMAGE="false"           # skip the hosted Kontext endpoint

# NVIDIA Cosmos image-to-video NIM (AI first-person walkthrough video).
# See docs/video-pipeline-setup.md. Without it the video is rendered in the browser.
COSMOS_INFERENCE_URL=""                 # e.g. http://gpu-box:8000/v1/infer
# COSMOS_EXTRA_PARAMS='{"num_frames":121}'  # model-specific request fields (JSON)
