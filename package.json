{
  "name": "stonesight-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit -p server",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "server": "tsx server/server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "check:providers": "tsx scripts/check-providers.ts",
    "eval:analysis": "tsx scripts/eval-analysis.ts",
    "start": "tsx server/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mediabunny": "^1.59.1",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "three": "^0.186.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
